# ============================================================================
# GenAI Cloud Security Copilot - Environment Configuration
# ============================================================================

# ── Gemini API Keys (Google AI) ──────────────────────────────────────────────
# Get your API keys from: https://aistudio.google.com/app/apikey
#
# Primary key (required for Gemini)
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Fallback keys (optional, for quota rotation)
# The system will automatically rotate to these keys if the primary key hits quota limits
GEMINI_API_KEY_1=your_fallback_gemini_key_1_here
GEMINI_API_KEY_2=your_fallback_gemini_key_2_here
GEMINI_API_KEY_3=your_fallback_gemini_key_3_here

# ── Claude API Key (Anthropic) ───────────────────────────────────────────────
# Get your API key from: https://console.anthropic.com/
# Only used if Gemini keys are not available
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# How It Works:
# ============================================================================
# 1. System tries GEMINI_API_KEY first
# 2. If quota exceeded, rotates to GEMINI_API_KEY_1
# 3. If that fails, rotates to GEMINI_API_KEY_2
# 4. If that fails, rotates to GEMINI_API_KEY_3
# 5. If all Gemini keys fail, falls back to ANTHROPIC_API_KEY (if set)
# 6. If no API keys work, uses mock mode (rule-based responses)
#
# You can provide 1-4 Gemini keys for redundancy.
# ============================================================================

# ── Usage Instructions ───────────────────────────────────────────────────────
# 1. Copy this file to `.env` in the backend folder
# 2. Replace the placeholder values with your actual API keys
# 3. Restart the backend: python api.py
# 4. Check the console for: "[LLM] ✅ Gemini AI connected (X API key(s) available)"
# ============================================================================
